# Copy to .env for local development. Every key maps to a field in app/core/config.py.
ENVIRONMENT=development
DEBUG=true
FRONTEND_URL=http://localhost:3000

# PostgreSQL started by docker-compose (see repo root; host port = POSTGRES_PORT in the
# root .env, 5434 by default). Use the SQLite line instead to run without Docker.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5434/intellihire
# DATABASE_URL=sqlite:///./dev.db

# Generate a real one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-secret-change-me-before-any-real-deployment
ACCESS_TOKEN_EXPIRE_MINUTES=1440

EMAIL_BACKEND=console
EMAIL_FROM=IntelliHire <no-reply@intellihire.local>

RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60

UPLOAD_DIR=uploads
