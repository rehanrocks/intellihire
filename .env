# ports

# adminer
MACHINE_ADMINER_PORT=8080
ADMINER_PORT=8080

# postgres (host port; 5434 avoids clashing with a locally installed PostgreSQL on 5432)
POSTGRES_PORT=5434
POSTGRES_PASSWORD=postgres
POSTGRES_USERNAME=postgres
POSTGRES_DB=intellihire

# content (API)
CONTENT_PORT=4010
ENVIRONMENT=development
SECRET_KEY=dev-only-secret-change-me-before-any-real-deployment
FRONTEND_URL=http://localhost:3000
EMAIL_BACKEND=console
